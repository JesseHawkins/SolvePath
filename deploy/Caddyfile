# SolvePath web server.
#
# SITE_ADDRESS decides the mode:
#   ":8080"          Behind your own front proxy (default). Plain HTTP inside
#                    the Docker network; the front proxy handles HTTPS.
#   "solvepath.app"  Standalone. Caddy gets HTTPS certificates automatically.
#                    Use with docker-compose.standalone.yml.

{
	admin off
}

# Internal health endpoint for Docker's healthcheck. Not published.
http://:8081 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		# 'wasm-unsafe-eval': cubing.js uses WebAssembly for some searches.
		# 'unsafe-inline' styles: the theme injects its color variables at startup.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# PocketBase API, same origin, so there's no CORS to configure.
	handle /api/* {
		reverse_proxy pocketbase:8090
	}

	# Never expose the PocketBase admin UI publicly. Use the LAN or an SSH tunnel.
	handle /_/* {
		respond 404
	}

	redir /admin-home /admin-home/
	handle_path /admin-home/* {
		basic_auth {
			{$ADMIN_HOME_USER} {$ADMIN_HOME_PASSWORD_HASH}
		}
		header Cache-Control "no-store"
		root * /srv/admin-home
		file_server
	}

	handle {
		root * /srv/site
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
