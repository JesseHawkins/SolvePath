# SolvePath deploy settings. Copy to deploy/.env and fill in.
# deploy/.env is git-ignored. Never commit real values.

# ---- Web server (Caddy) ----

# Where Caddy listens.
#   ":8080" (default): plain HTTP behind your own front proxy.
#   "your.domain": standalone mode with automatic HTTPS
#                  (use docker-compose.standalone.yml too).
SITE_ADDRESS=:8080

# Host address and port the web container is published on (behind-proxy mode).
# 127.0.0.1 keeps it reachable only from the server itself.
WEB_BIND=127.0.0.1
WEB_PORT=8088

# Login for the admin landing page at /admin-home/.
ADMIN_HOME_USER=admin
# A bcrypt hash, not the password itself. Make one with:
#   docker run --rm caddy:2.11.9-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
ADMIN_HOME_PASSWORD_HASH='$2a$14$replace-me'

# ---- PocketBase ----

# Admin UI binding. 127.0.0.1 means "SSH tunnel only". Use your server's LAN
# address to reach it from home devices. Never expose it to the internet.
PB_ADMIN_BIND=127.0.0.1
PB_ADMIN_PORT=8090

# ---- Build info ----

# Shown on the admin landing page. `make up` fills this in from git.
GIT_COMMIT=unknown

# ---- Email (used from M9, for parent account verification and password reset) ----
# Gmail example: smtp.gmail.com, port 587, STARTTLS, with an app password
# (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=SolvePath
