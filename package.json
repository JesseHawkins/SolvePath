{
  "name": "solvepath",
  "version": "0.0.0",
  "private": true,
  "description": "Camera-guided cube solving, learning, and speedcubing web app.",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "config",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @solvepath/web",
    "build": "npm run build -w @solvepath/web",
    "preview": "npm run preview -w @solvepath/web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tools/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:guide": "node tools/check-guide-anchors.ts",
    "check:licenses": "node tools/check-licenses.ts",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run check:guide && npm run check:licenses && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "three": "0.187.0",
    "@types/three": "0.187.0"
  }
}
